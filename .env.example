# ── 高德配置（必填才能用真实路网；不配置则自动用内置模拟路网演示）──
#
# 需要两类 Key，都在 https://console.amap.com/ 申请：
#   1) 「Web 服务」类型 Key   → AMAP_KEY（后端算路/POI/逆地理，仅服务端使用，绝不暴露给前端）
#   2) 「Web端(JS API)」Key   → VITE_AMAP_JS_KEY（前端地图渲染+定位；按高德设计需暴露，请配域名白名单）

AMAP_KEY=                 # 高德「Web 服务」Key（后端，必填才能真实算路）
AMAP_QPS=3                # Web 服务 QPS 限流（令牌桶）
AMAP_TIMEOUT_MS=8000      # 高德接口超时（毫秒）
# AMAP_REST_BASE=https://restapi.amap.com   # Web 服务 base，默认官方，代理/网关时覆盖

# ── 前端高德 JS API（可选；不配则前端仅用浏览器定位）──
VITE_AMAP_JS_KEY=         # 高德「Web端(JS API)」Key（前端地图+定位）
VITE_AMAP_JS_CODE=        # 对应的安全密钥 securityJsCode
# VITE_AMAP_JS_BASE=https://webapi.amap.com/maps   # JS API 加载地址，默认官方

# ── 服务 ──
# PORT=3000               # 生产端口
# LOOP_K=0.85             # 闭环算法标定系数（一般无需改）
